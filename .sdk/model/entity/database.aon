# Entity: database

main: kit: entity: database: {

  alias: field: {}

  fields: [
    {
      name: "created_time"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "last_edited_time"
      req: false
      type: "`$STRING`"
    }
    {
      name: "object"
      req: false
      type: "`$STRING`"
    }
    {
      name: "parent"
      op: {
        create: {
          req: true
          type: "`$OBJECT`"
        }
      }
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "properties"
      op: {
        create: {
          req: true
          type: "`$OBJECT`"
        }
      }
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "title"
      op: {
